discovery.docker "storix" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "storix" {
  targets = discovery.docker.storix.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(storix-app-blue|storix-app-green|storix-batch|storix-caddy)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // blue / green 어느 쪽이 떠 있어도 로그 쿼리가 그대로 storix-app 으로 잡히게 묶는다
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/storix-app-(blue|green)"
    target_label  = "container"
    replacement   = "storix-app"
  }

  rule {
    target_label = "job"
    replacement  = "storix"
  }

  rule {
    target_label = "env"
    replacement  = sys.env("ENV")
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("INSTANCE_ID")
  }
}

loki.source.docker "storix" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.storix.output
  forward_to = [loki.process.storix.receiver]
}

loki.process "storix" {
  stage.json {
    expressions = { level = "level" }
  }

  stage.labels {
    values = { level = "" }
  }

  forward_to = [
    loki.write.monitoring.receiver,
    loki.write.grafana_cloud.receiver,
    otelcol.receiver.loki.archive.receiver,
  ]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

// 백업용 원본. Cloud 는 보관 기간이 짧아서 S3 에 env 별 시간 단위로 쌓는다
// v1.4.2 는 compression 설정이 exporter 까지 안 넘어가서 압축 없이 저장한다. 1.8 부터 된다
otelcol.receiver.loki "archive" {
  output {
    logs = [otelcol.processor.batch.archive.input]
  }
}

otelcol.processor.batch "archive" {
  timeout         = "5m"
  send_batch_size = 10000

  output {
    logs = [otelcol.exporter.awss3.archive.input]
  }
}

otelcol.exporter.awss3 "archive" {
  s3_uploader {
    region              = "ap-northeast-2"
    s3_bucket           = sys.env("LOG_ARCHIVE_BUCKET")
    s3_prefix           = "logs/" + sys.env("ENV")
    s3_partition        = "hour"
  }

  marshaler {
    type = "otlp_json"
  }
}

loki.write "monitoring" {
  endpoint {
    url = "http://" + sys.env("MONITORING_HOST") + ":3100/loki/api/v1/push"

    basic_auth {
      username = sys.env("LOKI_USER")
      password = sys.env("LOKI_PASSWORD")
    }
  }
}


prometheus.exporter.cadvisor "storix" {
  docker_host = "unix:///var/run/docker.sock"
}

prometheus.exporter.unix "storix" { }

prometheus.scrape "infra" {
  targets = concat(
    prometheus.exporter.cadvisor.storix.targets,
    prometheus.exporter.unix.storix.targets,
  )
  scrape_interval = "15s"
  forward_to      = [
    prometheus.remote_write.monitoring.receiver,
    prometheus.remote_write.grafana_cloud.receiver,
  ]
}

// blue / green 중 떠 있는 쪽과 batch 를 서버 안에서 바로 긁는다. Caddy 9100 을 거치지 않는다
discovery.relabel "apps" {
  targets = discovery.docker.storix.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(storix-app-blue|storix-app-green|storix-batch)"
    action        = "keep"
  }

  // 이미지가 포트를 노출하지 않아서 storix-net 안의 컨테이너 이름으로 주소를 잡는다. app 의 actuator 는 관리 포트 9100
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(storix-app-blue|storix-app-green)"
    target_label  = "__address__"
    replacement   = "$1:9100"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/storix-batch"
    target_label  = "__address__"
    replacement   = "storix-batch:9101"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/storix-app-(blue|green)"
    target_label  = "application"
    replacement   = "storix-api"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/storix-batch"
    target_label  = "application"
    replacement   = "storix-batch"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/storix-app-(blue|green)"
    target_label  = "slot"
  }
}

prometheus.scrape "apps" {
  targets         = discovery.relabel.apps.output
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "monitoring" {
  external_labels = {
    env         = sys.env("ENV"),
    instance_id = sys.env("INSTANCE_ID"),
  }

  endpoint {
    url = "http://" + sys.env("MONITORING_HOST") + ":9091/api/v1/write"

    basic_auth {
      username = sys.env("LOKI_USER")
      password = sys.env("LOKI_PASSWORD")
    }
  }
}

prometheus.remote_write "grafana_cloud" {
  external_labels = {
    env         = sys.env("ENV"),
    instance_id = sys.env("INSTANCE_ID"),
  }

  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}
