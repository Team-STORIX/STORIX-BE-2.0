{
  "uid": "storix-ai-chat",
  "title": "STORIX AI 채팅",
  "tags": [
    "storix",
    "ai-chat"
  ],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "custom",
        "query": "dev,prod",
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": true
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "답변 수",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(increase(ai_chat_answer_seconds_count{env=\"$env\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "기간 안에 끝난 답변 (done · error)"
    },
    {
      "id": 2,
      "title": "오류율",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(increase(ai_chat_answer_seconds_count{env=\"$env\",status=\"ERROR\"}[$__range])) / sum(increase(ai_chat_answer_seconds_count{env=\"$env\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "범위 밖 비율",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(increase(ai_chat_answer_seconds_count{env=\"$env\",status=\"OFF_TOPIC\"}[$__range])) / sum(increase(ai_chat_answer_seconds_count{env=\"$env\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "출시 기준: 범위 밖 질문 차단 95% 이상은 평가 세트(EV-02)로 따로 잰다. 여기는 실사용 비율"
    },
    {
      "id": 4,
      "title": "결과 없음 비율",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(increase(ai_chat_answer_seconds_count{env=\"$env\",status=~\"NO_RESULT|WORK_NOT_FOUND\"}[$__range])) / sum(increase(ai_chat_answer_seconds_count{env=\"$env\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "비용 추정",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "(sum(increase(ai_chat_tokens_total{env=\"$env\",model=~\"claude-sonnet-5-5.*\",type=\"input\"}[$__range])) or vector(0)) * 2e-6 + (sum(increase(ai_chat_tokens_total{env=\"$env\",model=~\"claude-sonnet-5-5.*\",type=\"output\"}[$__range])) or vector(0)) * 1e-5 + (sum(increase(ai_chat_tokens_total{env=\"$env\",model=~\"claude-sonnet-5-5.*\",type=\"cache_read\"}[$__range])) or vector(0)) * 1e-7 + (sum(increase(ai_chat_tokens_total{env=\"$env\",model=~\"claude-haiku-5-5.*\",type=\"input\"}[$__range])) or vector(0)) * 1e-7 + (sum(increase(ai_chat_tokens_total{env=\"$env\",model=~\"claude-haiku-5-5.*\",type=\"output\"}[$__range])) or vector(0)) * 5e-7",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "토큰 × 단가. Sonnet 5.5 입력 $2 · 출력 $10 · 캐시 읽기 $0.10, Haiku 5.5 입력 $0.10 · 출력 $0.50 (100만 토큰당). 캐시 쓰기는 AI 서버가 넘기지 않아 빠짐"
    },
    {
      "id": 6,
      "title": "답변당 비용",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "((sum(increase(ai_chat_tokens_total{env=\"$env\",model=~\"claude-sonnet-5-5.*\",type=\"input\"}[$__range])) or vector(0)) * 2e-6 + (sum(increase(ai_chat_tokens_total{env=\"$env\",model=~\"claude-sonnet-5-5.*\",type=\"output\"}[$__range])) or vector(0)) * 1e-5 + (sum(increase(ai_chat_tokens_total{env=\"$env\",model=~\"claude-sonnet-5-5.*\",type=\"cache_read\"}[$__range])) or vector(0)) * 1e-7 + (sum(increase(ai_chat_tokens_total{env=\"$env\",model=~\"claude-haiku-5-5.*\",type=\"input\"}[$__range])) or vector(0)) * 1e-7 + (sum(increase(ai_chat_tokens_total{env=\"$env\",model=~\"claude-haiku-5-5.*\",type=\"output\"}[$__range])) or vector(0)) * 5e-7) / sum(increase(ai_chat_answer_seconds_count{env=\"$env\",responder=\"server\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "AI 서버가 만든 답변 기준. mock 답변은 비용이 없다"
    },
    {
      "id": 7,
      "title": "답변 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ai_chat_answer_seconds_bucket{env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_chat_answer_seconds_bucket{env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "질문 받은 때부터 done · error 까지. 목표 5~10초"
    },
    {
      "id": 8,
      "title": "첫 글자 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ai_chat_first_token_seconds_bucket{env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_chat_first_token_seconds_bucket{env=\"$env\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "목표 2~3초"
    },
    {
      "id": 9,
      "title": "결과별 답변 수",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (status) (increase(ai_chat_answer_seconds_count{env=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "오류 코드별",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (error) (increase(ai_chat_answer_seconds_count{env=\"$env\",status=\"ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{error}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "토큰 (1시간)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (model, type) (increase(ai_chat_tokens_total{env=\"$env\"}[1h]))",
          "legendFormat": "{{model}} {{type}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
