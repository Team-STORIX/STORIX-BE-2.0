# 앱 서버 앞단. Let's Encrypt 인증서를 직접 받고 지금 살아 있는 blue 또는 green app 컨테이너로 보낸다.
# 어느 색으로 보낼지는 deploy.sh 가 upstream.caddy 에 적고 caddy reload 로 바꾼다.
{
	admin localhost:2019
	# 앱이 응답하지 않을 때 남는 오류 로그에도 요청 주소가 찍혀서 같은 값을 지운다
	log default {
		output stderr
		format filter {
			request>uri query {
				delete code
				delete state
			}
		}
	}
}

# 접속 로그는 alloy 가 Loki 로 보낸다. 로그인 콜백의 일회용 code · state 는 지운다
(access_log) {
	log {
		output stdout
		format filter {
			request>uri query {
				delete code
				delete state
			}
			resp_headers delete
		}
	}
}

import /etc/caddy/upstream.caddy

{$SITE_DOMAIN} {
	import access_log
	reverse_proxy {
		import app_upstream
	}
}

# 모니터링 서버의 Prometheus 가 이 포트를 긁는다
:9100 {
	reverse_proxy {
		import metrics_upstream
	}
}
