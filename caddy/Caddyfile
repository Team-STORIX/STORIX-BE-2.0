# 앱 서버 앞단. Let's Encrypt 인증서를 직접 받고 지금 살아 있는 blue 또는 green app 컨테이너로 보낸다.
# 어느 색으로 보낼지는 deploy.sh 가 upstream.caddy 에 적고 caddy reload 로 바꾼다.
{
	admin localhost:2019
	# 앱이 응답하지 않을 때 남는 오류 로그에도 요청 주소 · 헤더가 찍혀서 같은 값과 내부 API 토큰을 지운다
	log default {
		output stderr
		format filter {
			request>uri query {
				delete code
				delete state
			}
			request>headers>X-Internal-Token delete
			request>headers>X-Internal-Api-Key delete
		}
	}
}

# 접속 로그는 alloy 가 Loki 로 보낸다. 로그인 콜백의 일회용 code · state 와 내부 API 토큰은 지운다
(access_log) {
	log {
		output stdout
		format filter {
			request>uri query {
				delete code
				delete state
			}
			request>headers>X-Internal-Token delete
			request>headers>X-Internal-Api-Key delete
			resp_headers delete
		}
	}
}

import /etc/caddy/upstream.caddy

{$SITE_DOMAIN} {
	import access_log
	# AI 서버 전용 내부 API 는 밖에서 못 부른다. AI 서버는 아래 :8081 로 들어온다
	handle /internal/ai/* {
		respond 404
	}
	handle {
		reverse_proxy {
			import app_upstream
		}
	}
}

# storix-net 안에서 AI 서버가 Spring 을 부르는 입구. 호스트에 포트를 열지 않는다 (compose ports 에 없음)
# blue · green 교체를 따라가도록 app 컨테이너 이름 대신 Caddy 를 거친다
:8081 {
	reverse_proxy {
		import app_upstream
	}
}

# 모니터링 서버의 Prometheus 가 이 포트를 긁는다. /batch/* 는 batch 컨테이너 지표로 보낸다
:9100 {
	handle_path /batch/* {
		reverse_proxy storix-batch:9101
	}
	handle {
		reverse_proxy {
			import metrics_upstream
		}
	}
}
