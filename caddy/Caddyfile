# 앱 서버 앞단. Let's Encrypt 인증서를 직접 받고 지금 살아 있는 blue 또는 green app 컨테이너로 보낸다.
# 어느 색으로 보낼지는 deploy.sh 가 upstream.caddy 에 적고 caddy reload 로 바꾼다.
{
	admin localhost:2019
}

import /etc/caddy/upstream.caddy

{$SITE_DOMAIN} {
	reverse_proxy {
		import app_upstream
	}
}

# ALB 를 떼기 전까지 ALB 가 이 포트로 보낸다.
# RateLimitFilter 가 X-Forwarded-For 맨 뒤 값을 접속 IP 로 쓰므로 ALB 가 붙인 값을 그대로 넘긴다.
# Let's Encrypt 의 HTTP-01 발급 확인 요청도 ALB 를 거쳐 이 포트로 들어와 처리된다.
:8080 {
	reverse_proxy {
		import app_upstream
		header_up X-Forwarded-For {header.X-Forwarded-For}
	}
}

# 모니터링 서버의 Prometheus 가 이 포트를 긁는다
:9100 {
	reverse_proxy {
		import metrics_upstream
	}
}
