# 서버의 /home/ubuntu/storix/.env 에 들어가는 변수. 값은 저장소에 두지 않는다.
# 값은 Parameter Store 의 /storix/<dev|prod>/env/<이름> 에 있고, 배포가 deploy/render-env.py 로 .env 를 만든다.
# 변수를 추가하려면 여기에 이름을 적고 Parameter Store 두 경로에 값을 넣는다.
# INSTANCE_ID 는 서버가 자기 값으로 채운다. Parameter Store 에 넣지 않는다.
# ENV 는 dev 또는 prod. 스프링 프로파일과 로그 라벨에 같이 쓰인다.
# ECR_REGISTRY 는 이미지 저장소 주소 전체다 (<계정 ID>.dkr.ecr.<리전>.amazonaws.com).
# IMAGE_TAG 만 배포가 넘긴다. 손으로 올릴 때는 직접 지정한다.
ADMIN_IDENTIFIER=
APPLE_AUTH_CLIENT=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_TEAM_ID=
APP_VERSION_ANDROID_LATEST=
APP_VERSION_ANDROID_MIN_SUPPORTED=
APP_VERSION_ANDROID_RELEASE_DATE=
APP_VERSION_IOS_LATEST=
APP_VERSION_IOS_MIN_SUPPORTED=
APP_VERSION_IOS_RELEASE_DATE=
AWS_CREDENTIALS_ACCESS_KEY=
AWS_CREDENTIALS_SECRET_KEY=
AWS_S3_BASE_URL=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=
DB_PASSWORD=
DB_URL=
DB_USERNAME=
ECR_REGISTRY=
ENV=
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_PROJECT_ID=
INSTANCE_ID=
JWT_ACCESS_TOKEN_VALIDITY_MS=
JWT_ONBOARDING_TOKEN_VALIDITY_MS=
JWT_REFRESH_TOKEN_VALIDITY_MS=
JWT_SECRET_KEY=
KAKAO_AUTH_ADMIN=
KAKAO_AUTH_CLIENT=
KAKAO_AUTH_NATIVE=
KAKAO_AUTH_SECRET=
LOKI_PASSWORD=
LOKI_USER=
MONITORING_HOST=
NAVER_AUTH_CLIENT=
NAVER_AUTH_SECRET=
OAUTH_TOKEN_AES_KEY=
PORTONE_API_SECRET=
PORTONE_CHANNEL_KEY=
PORTONE_STORE_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=
SWAGGER_PASSWORD=
SWAGGER_USER=
X_AUTH_CLIENT=
X_AUTH_SECRET=
